# GPU environments, per-machine settings, and local result archives
.venv-gpu/
configs/server/local.json

# Local machine-specific server directory record
/docs/*.local.md

# All experiment outputs and written results stay local.
/artifacts/*
/reports/*
/results/
/outputs/
/output/
/logs/
# Personal research documentation stays local, including blank templates.
/docs/
/Jev × dLLM 10-Week Timeline.pdf
/configs/README.md
/data/README.md

# Unused future interfaces and detailed module notes remain local.
/src/jev_dllm/pruning/
/src/jev_dllm/backends/base.py
/src/jev_dllm/judges/base.py
/src/jev_dllm/**/README.md

# Per-run outputs and transient diagnostics; reviewed summaries remain shareable
/artifacts/*
/reports/generated/
/reports/runs/
/results/
/outputs/
/output/
/logs/
/coverage/
/htmlcov/
/.coverage*
/coverage.xml
*.log
nohup.out
*.swp
*~
/tmp/
/temp/

# Local-only notes; project plans and decisions are shared
/docs/*.local.md

# Fetched third-party source; revisions and fetch instructions live in README
third_party/*
!third_party/README.md

